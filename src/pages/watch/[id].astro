---
import Layout from '../../layouts/Layout.astro'
import HlsPlayer from '../../components/HlsPlayer'

const { id } = Astro.params

// Nginxコンテナ経由で配信されるHLSファイルのURL
// Mixed Contentエラー（HTTPSからHTTPへのリクエスト）を避け、かつポート番号を排除するため、
// クライアント側で現在のプロトコルとホスト名を自動的に使用するように構成します。
const hlsUrl = `/hls/${id}/index.m3u8`
---

<Layout title={`${id} を視聴中 - NexStream`}>
  <main class="py-4">
    <div class="grid grid-cols-1 gap-8 xl:grid-cols-4">
      <!-- プレイヤーエリア -->
      <div class="xl:col-span-3">
        <!-- Immersive Player Wrapper -->
        <div class="overflow-hidden rounded-3xl bg-black shadow-2xl ring-1 ring-white/10">
          <HlsPlayer client:load src={hlsUrl} />
        </div>
        
        <!-- Video Header -->
        <div class="mt-8 px-2">
          <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
            <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white md:text-3xl">
              動画作品: {id}
            </h1>
            <div class="flex items-center gap-3">
              <button class="inline-flex items-center rounded-full bg-gray-100 px-5 py-2.5 text-sm font-bold text-gray-900 transition hover:bg-gray-200 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700">
                <svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 10.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zM6 10.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zM10 10.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0z"></path></svg>
                保存
              </button>
              <button class="inline-flex items-center rounded-full bg-primary-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-primary-500/30 transition hover:bg-primary-700">
                共有
              </button>
            </div>
          </div>
          
          <!-- Channel Info -->
          <div class="mt-6 flex items-center justify-between border-b border-t border-gray-100 py-6 dark:border-gray-800">
            <div class="flex items-center">
              <div class="h-12 w-12 rounded-full bg-gradient-to-tr from-primary-400 to-primary-600 shadow-md"></div>
              <div class="ml-4">
                <h4 class="font-bold text-gray-900 dark:text-white">管理者ユーザー</h4>
                <p class="text-sm text-gray-500">1.2k 登録者</p>
              </div>
              <button class="ml-6 rounded-full bg-gray-900 px-6 py-2 text-sm font-bold text-white transition hover:bg-black dark:bg-white dark:text-black">
                チャンネル登録
              </button>
            </div>
          </div>

          <!-- Description Box -->
          <div class="mt-6 rounded-2xl bg-gray-100 p-6 dark:bg-gray-800">
            <div class="flex items-center gap-4 text-sm font-bold text-gray-900 dark:text-white">
              <span>再生回数: 1,024回</span>
              <span>公開日: 本日</span>
            </div>
            <p class="mt-4 text-gray-700 dark:text-gray-300">
              この動画は自動変換システムによってHLS形式で配信されています。高品質な視聴体験を提供するため、ネットワーク状況に応じて解像度が調整されます。
            </p>
            <button class="mt-4 text-sm font-bold text-gray-900 hover:underline dark:text-white">もっと見る</button>
          </div>
        </div>
      </div>

      <!-- サイドバー (おすすめ等) -->
      <div class="xl:col-span-1">
        <h4 class="mb-6 px-2 text-lg font-bold text-gray-900 dark:text-white">次におすすめ</h4>
        <div class="space-y-6">
          {[1, 2, 3, 4, 5].map((i) => (
            <div class="group flex gap-3 px-2">
              <div class="relative h-24 w-40 flex-shrink-0 overflow-hidden rounded-xl bg-gray-200 shadow-sm transition group-hover:shadow-md dark:bg-gray-700">
                <div class="absolute inset-0 bg-gray-900/10 group-hover:bg-transparent"></div>
              </div>
              <div class="flex flex-col justify-center">
                <h5 class="text-sm font-bold leading-tight text-gray-900 line-clamp-2 dark:text-white group-hover:text-primary-600">おすすめの関連動画タイトル {i}</h5>
                <p class="mt-1 text-xs text-gray-500">NexStream 公式</p>
                <p class="text-xs text-gray-500">2.5万回視聴 &middot; 3日前</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>
</Layout>
