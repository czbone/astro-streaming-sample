---
import Layout from '../layouts/Layout.astro'
import fs from 'node:fs/promises'
import path from 'node:path'
import process from 'node:process'

const hlsDir = path.join(process.cwd(), 'data', 'hls')
let videos = []

try {
  const dirs = await fs.readdir(hlsDir)
  videos = dirs.filter((dir) => !dir.startsWith('.'))
} catch (e) {
  console.error('Error reading HLS directory:', e)
}
---

<Layout title="ホーム - NexStream">
  <main class="py-4">
    <!-- Hero Section -->
    <section class="mb-12">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-primary-700 to-primary-900 p-8 shadow-2xl md:p-12">
        <div class="relative z-10 max-w-2xl">
          <h2 class="mb-4 text-4xl font-extrabold text-white md:text-5xl">お気に入りの動画を、<br/>いつでも、どこでも。</h2>
          <p class="mb-8 text-lg text-primary-100">NexStreamは、高品質なHLSストリーミングを提供する次世代の動画共有プラットフォームです。</p>
          <div class="flex flex-wrap gap-4">
            <a href="/upload" class="inline-flex items-center rounded-full bg-white px-6 py-3 text-base font-bold text-primary-700 transition hover:bg-gray-100">
              今すぐアップロード
            </a>
            <a href="#library" class="inline-flex items-center rounded-full border-2 border-white/30 bg-white/10 px-6 py-3 text-base font-bold text-white backdrop-blur-sm transition hover:bg-white/20">
              ライブラリを見る
            </a>
          </div>
        </div>
        <!-- Abstract Shapes for Hero -->
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
        <div class="absolute -bottom-20 right-20 h-96 w-96 rounded-full bg-primary-400/20 blur-3xl"></div>
      </div>
    </section>

    <!-- Content Section -->
    <div id="library" class="mb-8 flex items-center justify-between px-2">
      <h3 class="flex items-center text-2xl font-bold text-gray-900 dark:text-white">
        <span class="mr-3 h-8 w-1.5 rounded-full bg-primary-600"></span>
        すべての動画
      </h3>
      <div class="flex gap-2">
        <button class="rounded-lg bg-white p-2 text-gray-500 shadow-sm transition hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M5 4a1 1 0 00-2 0v12a1 1 0 102 0V4zM9 4a1 1 0 00-2 0v12a1 1 0 102 0V4zM13 4a1 1 0 00-2 0v12a1 1 0 102 0V4zM17 4a1 1 0 00-2 0v12a1 1 0 102 0V4z"></path></svg>
        </button>
      </div>
    </div>

    {
      videos.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <div class="mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800">
            <svg class="h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          </div>
          <p class="text-xl font-medium text-gray-500 dark:text-gray-400">まだ動画がアップロードされていません。</p>
          <a href="/upload" class="mt-4 text-primary-600 font-semibold hover:underline">最初の動画をアップロードしましょう &rarr;</a>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 px-2">
          {videos.map((id) => (
            <div class="group cursor-pointer">
              <a href={`/watch/${id}`} class="relative block aspect-video overflow-hidden rounded-2xl bg-gray-900 shadow-lg">
                <div class="absolute inset-0 flex items-center justify-center transition-transform duration-500 group-hover:scale-110">
                  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-md transition-all group-hover:bg-primary-600 group-hover:shadow-xl">
                    <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.333-5.89a1.5 1.5 0 000-2.538L6.3 2.841z"></path></svg>
                  </div>
                </div>
                <div class="absolute bottom-3 right-3 rounded-md bg-black/70 px-2 py-1 text-xs font-bold text-white backdrop-blur-sm">
                  HLS
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>
              </a>
              <div class="mt-4">
                <a href={`/watch/${id}`}>
                  <h4 class="text-lg font-bold leading-tight text-gray-900 line-clamp-2 dark:text-white group-hover:text-primary-600 transition-colors">
                    動画作品: {id}
                  </h4>
                </a>
                <div class="mt-2 flex items-center text-sm text-gray-500 dark:text-gray-400">
                  <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-primary-400 to-primary-600 mr-2 shadow-sm"></div>
                  <span>管理者ユーザー</span>
                  <span class="mx-2 font-black">&middot;</span>
                  <span>本日</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </main>
</Layout>
